# Azure OpenAI (GPT models)
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2025-11-01-preview
# Optional override. Defaults to AZURE_OPENAI_ENDPOINT + /openai/v1/.
# AZURE_OPENAI_RESPONSES_BASE_URL=https://your-resource.openai.azure.com/openai/v1/

# Azure AI Foundry (Claude models)
AZURE_FOUNDRY_API_KEY=your-foundry-api-key-here
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
AZURE_CLAUDE_HAIKU=claude-haiku-4-5
AZURE_CLAUDE_OPUS=claude-opus-4-5
AZURE_CLAUDE_SONNET=claude-sonnet-4-5
AZURE_FOUNDRY_CLAUDE_API_ENDPOINT=https://your-resource.openai.azure.com/anthropic

# Firecrawl (Web Scraping & Document Parsing)
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# Qlik Cloud REST façade (install the qlik_cloud extra first)
QLIK_CLOUD_API_KEY=replace-with-a-long-random-secret
QLIK_CLOUD_HOST=127.0.0.1
QLIK_CLOUD_PORT=8080
QLIK_CLOUD_MAX_ROWS=10000
# Set true only for local development without authentication.
QLIK_CLOUD_ALLOW_INSECURE=false
# Set true only when interactive OpenAPI docs are intentionally exposed.
QLIK_CLOUD_ENABLE_DOCS=false

# Runtime
# Optional: override the persistent temp folder used by Prophet/CmdStanPy.
# Leave blank to use qlik-py-env/tmp.
# QLIK_PY_TOOLS_TEMP_DIR=F:\qlik-sse-tools\qlik-py-env\tmp

# SSE operational settings
QLIK_SSE_PORT=50055
QLIK_SSE_WORKERS=10
QLIK_SSE_MAX_MESSAGE_MB=10
QLIK_SSE_SHUTDOWN_GRACE_SECONDS=5
