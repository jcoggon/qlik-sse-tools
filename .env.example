# Azure OpenAI (GPT models)
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2025-11-01-preview
# Optional override. Defaults to AZURE_OPENAI_ENDPOINT + /openai/v1/.
# AZURE_OPENAI_RESPONSES_BASE_URL=https://your-resource.openai.azure.com/openai/v1/

# Server-owned LLM backend selection. Existing Azure installations use the defaults.
# QLIK_LLM_RESPONSES_BACKEND=azure_openai  # azure_openai, openai, codex_cli, gemini, ollama
# QLIK_LLM_CHAT_BACKEND=azure_openai  # azure_openai, openai
# QLIK_CLOUD_RESPONSES_BACKEND=azure_openai  # azure_openai, openai
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Shared CLI pilot. Sign in using the OS identity running the SSE service.
# QLIK_LLM_CODEX_BIN=C:\path\to\codex.exe
# QLIK_LLM_CODEX_HOME=C:\path\to\dedicated-codex-profile
# QLIK_LLM_CODEX_STATE_DIR=C:\path\to\persistent-codex-state
# QLIK_LLM_CODEX_MODEL=
# QLIK_LLM_CLAUDE_BIN=C:\path\to\claude.exe
# QLIK_LLM_CLAUDE_CONFIG_DIR=C:\path\to\dedicated-claude-profile
# QLIK_LLM_CLAUDE_MODEL=sonnet
# QLIK_LLM_CLI_TIMEOUT_SECONDS=90
# QLIK_LLM_CLI_MAX_ROWS=8
# QLIK_LLM_CLI_CONCURRENCY=1

# Google Gemini API and local Ollama. Select gemini or ollama above to enable.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=

# Azure AI Foundry (Claude models)
AZURE_FOUNDRY_API_KEY=your-foundry-api-key-here
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
AZURE_CLAUDE_HAIKU=your-haiku-deployment
AZURE_CLAUDE_OPUS=your-opus-deployment
AZURE_CLAUDE_SONNET=your-sonnet-deployment
AZURE_FOUNDRY_CLAUDE_API_ENDPOINT=https://your-resource.openai.azure.com/anthropic
# QLIK_LLM_CLAUDE_BACKEND=foundry  # foundry, anthropic, claude_cli
# ANTHROPIC_API_KEY=
# ANTHROPIC_HAIKU_MODEL=claude-haiku-5-5
# ANTHROPIC_SONNET_MODEL=claude-sonnet-5-5
# ANTHROPIC_OPUS_MODEL=claude-opus-5-5
# QLIK_LLM_CLAUDE_SAMPLING=false  # for a named deployment that rejects temperature

# Firecrawl (Web Scraping & Document Parsing)
FIRECRAWL_API_KEY=your-firecrawl-api-key-here
# FIRECRAWL_EXTRACT_MAX_CREDITS=100

# Qlik Cloud REST façade (install the qlik_cloud extra first)
QLIK_CLOUD_API_KEY=replace-with-a-long-random-secret
QLIK_CLOUD_HOST=127.0.0.1
QLIK_CLOUD_PORT=8080
QLIK_CLOUD_MAX_ROWS=10000
# Set true only for local development without authentication.
QLIK_CLOUD_ALLOW_INSECURE=false
# Set true only when interactive OpenAPI docs are intentionally exposed.
QLIK_CLOUD_ENABLE_DOCS=false

# Runtime
# Optional: override the persistent temp folder used by Prophet/CmdStanPy.
# Leave blank to use qlik-py-env/tmp.
# QLIK_PY_TOOLS_TEMP_DIR=F:\qlik-sse-tools\qlik-py-env\tmp

# SSE operational settings
# Remote clients require an explicit bind address and mutual TLS.
QLIK_SSE_HOST=127.0.0.1
QLIK_SSE_PORT=50055
QLIK_SSE_WORKERS=10
QLIK_SSE_MAX_MESSAGE_MB=10
QLIK_SSE_SHUTDOWN_GRACE_SECONDS=5
